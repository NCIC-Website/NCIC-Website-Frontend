# NCIC Frontend Environment Configuration
# ==========================================
# Copy this to .env.local and fill with actual values

# API Configuration
VITE_API_URL=https://your-backend-api.com
# For development: VITE_API_URL=http://localhost:8001

# Admin Security
VITE_ADMIN_SECRET=NCIC_ADMIN_2024_SECURE_KEY_CHANGE_THIS

# Optional: Analytics & Monitoring
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX
# VITE_SENTRY_DSN=https://your-sentry-key@sentry.io/project-id